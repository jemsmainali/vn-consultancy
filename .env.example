# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_a_real_32_byte_hex_secret

ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Postgres connection string
DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
# Neon: direct (non-pooler) URL for Alembic migrations. Leave empty for local Postgres.
DATABASE_URL_UNPOOLED=

# Bank details are always required for the "Other" role; this flag is no longer read.
REQUIRE_BANK_DETAILS_FOR_NON_STUDENTS=false
# Required for "Other" sign-ups (account numbers are stored encrypted). Back it up.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_DATA_ENCRYPTION_KEY=

# Comma-separated list of allowed frontend origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload storage
# local = files under UPLOAD_DIR (development). r2 = private Cloudflare R2 bucket (required in production).
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

ENVIRONMENT=development
# Set to production on the live server. Startup then refuses unsafe settings
# (weak SECRET_KEY, COOKIE_SECURE=false, email disabled, http/localhost CORS).
# COOKIE_SECURE=true sends auth cookies over HTTPS only. Required in production.
COOKIE_SECURE=false

# No longer used: staff/principal sign-up needs email verification + staff approval instead.
STAFF_INVITE_CODE=
PRINCIPAL_INVITE_CODE=

# Email (OTP verification, password reset, approval notices).
# false = development only: emails are printed to the server terminal.
EMAIL_ENABLED=false
# Sent through the Brevo transactional HTTPS API (the sender domain needs SPF + DKIM verified in Brevo).
BREVO_API_KEY=
EMAIL_FROM_NAME=VN Group
EMAIL_FROM_ADDRESS=noreply@send.yourdomain.com
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Public address of the React app; verification links in emails point here (https:// in production).
FRONTEND_URL=http://localhost:5173
# How long an emailed verification link works.
EMAIL_VERIFY_EXPIRE_HOURS=24
# Comma-separated addresses allowed to register as VN Group staff. Everyone else is refused.
STAFF_EMAILS=

# Set to /api when the frontend proxies /api/* to this API (see render.yaml).
API_PATH_PREFIX=

# Wrong passwords allowed per email address (from any IP) before sign-in pauses, and for how many minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Header holding the visitor's real IP for per-IP rate limits. Render's Cloudflare sets this one.
# Set it empty if the API is ever reachable without Cloudflare in front (then limits use the socket address).
CLIENT_IP_HEADER=cf-connecting-ip
