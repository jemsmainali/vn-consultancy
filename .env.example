# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_a_real_32_byte_hex_secret

ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Postgres connection string
DATABASE_URL=postgresql+asyncpg://consultancy_user:jems@localhost:54321/consultancy_db

# Enable only after the frontend is ready. Default is false in code.
REQUIRE_BANK_DETAILS_FOR_NON_STUDENTS=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set a private Fernet key before enabling REQUIRE_BANK_DETAILS_FOR_NON_STUDENTS.
BANK_DATA_ENCRYPTION_KEY=

# Comma-separated list of allowed frontend origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

ENVIRONMENT=development
