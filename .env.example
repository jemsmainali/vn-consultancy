# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_a_real_32_byte_hex_secret

ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Postgres connection string
DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
# Neon: direct (non-pooler) URL for Alembic migrations. Leave empty for local Postgres.
DATABASE_URL_UNPOOLED=

# Bank details are always required for the "Other" role; this flag is no longer read.
REQUIRE_BANK_DETAILS_FOR_NON_STUDENTS=false
# Required for "Other" sign-ups (account numbers are stored encrypted). Back it up.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_DATA_ENCRYPTION_KEY=

# Comma-separated list of allowed frontend origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

ENVIRONMENT=development
# Set to production on the live server. Startup then refuses unsafe settings
# (weak SECRET_KEY, COOKIE_SECURE=false, email disabled, http/localhost CORS).
# COOKIE_SECURE=true sends auth cookies over HTTPS only. Required in production.
COOKIE_SECURE=false

# Invite codes for staff and principal sign-up. Use long random values.
STAFF_INVITE_CODE=
PRINCIPAL_INVITE_CODE=

# Email (OTP verification, password reset, approval notices).
# false = development only: emails are printed to the server terminal.
EMAIL_ENABLED=false
# Use a transactional provider that signs mail for your domain (SPF + DKIM).
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="VN Group <no-reply@yourdomain.com>"
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Public demo only (synthetic data). Lets ENVIRONMENT=production run without SMTP;
# OTP emails are written to the private server log instead.
DEMO_MODE=false
# Set to /api when the frontend proxies /api/* to this API (see render.yaml).
API_PATH_PREFIX=
